# PULSE VIDEO — environment variables (copy to .env and fill in real values)
# Never commit your real .env to GitHub.

# Admin access code typed into the site search box to open the admin panel.
# The live site's real code is NOT in this repo — set your own value here.
ADMIN_CODE=change-me-admin-code

# Secret used to sign the 12-hour admin session tokens (HMAC-SHA256).
# Use a long random string, e.g. generated with: openssl rand -hex 32
ADMIN_TOKEN_SECRET=change-me-long-random-secret
